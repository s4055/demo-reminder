        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"reminder-backend\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"reminder-backend\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
