          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "대기 중인 요청",
      "description": "커넥션을 기다리는 요청 수입니다. 0보다 큰 상태가 5분 넘게 계속되면 DbConnectionPending 알림이 발생합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
