          "expr": "sum by (pool) (hikaricp_connections_active{instance=~\"$instance\"})",
          "legendFormat": "{{pool}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
